# Photobox Gallery — Server config (Coolify env)
SECRET_KEY=change-me-openssl-rand-hex-32
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
DATA_DIR=/data
BASE_URL=https://photobox.example.org
# Where users get the source of this gallery (AGPL section 13). Set it when you
# run a modified version; without it the About page links the project itself.
# PHOTOBOX_SOURCE_URL=https://git.example.org/you/photobox-gallery
# Reverse proxy (S-5, 15.11.2026). Off by default, and off in this template
# (second review R2-U6): docker-compose.nas.yml publishes port 5000 in the
# LAN, and with 1 anyone who reaches that port can fake the address the login
# brakes count. Set TRUST_PROXY=1 only when the container is reachable solely
# through one reverse proxy (Coolify/Traefik, Caddy, nginx, the NAS's own
# proxy with BIND_ADDR=127.0.0.1); then the gallery reads the client address
# from X-Forwarded-For. Behind Coolify set 1, otherwise every visitor appears
# with the proxy's address and the login brakes count them all together.
TRUST_PROXY=0
# Further host names that may appear in links when BASE_URL is not set
# (comma-separated). Without BASE_URL and without a match, reset mails and
# pairing codes are refused rather than built from the request's Host header.
# ALLOWED_HOSTS=galerie.example.de,fotos.example.de
ALLOWED_HOSTS=
